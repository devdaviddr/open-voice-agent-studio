# Copy to .env for local overrides. Docker Compose sets the service URLs itself.
OVAS_DATABASE_URL=postgresql+asyncpg://ovas:ovas@localhost:5432/ovas
OVAS_RUNTIME_URL=http://localhost:8100
OVAS_TTS_URL=http://localhost:8002
OVAS_STT_URL=http://localhost:8003
# Browser origins allowed to make state-changing requests (JSON list).
OVAS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Encrypts stored secrets such as LLM API keys. Generate with: openssl rand -hex 32
OVAS_SECRET_KEY=
# Shared by api and runtime to sign session tokens. Generate with: openssl rand -hex 32
OVAS_INTERNAL_KEY=
# Default LLM until the workspace owner sets one (any OpenAI-compatible endpoint).
OVAS_DEFAULT_LLM_URL=http://host.docker.internal:11434/v1
OVAS_DEFAULT_LLM_MODEL=qwen3.5:9b

# Speech-to-text model for push-to-talk (tiny, base, small, medium, large-v3, ...). Bigger is slower.
OVAS_WHISPER_MODEL=base

# Knowledge base embeddings (downloaded on first index, about 130 MB).
OVAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OVAS_EMBEDDING_CACHE_DIR=.models/embeddings
