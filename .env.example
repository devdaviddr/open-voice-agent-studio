# Copy to .env for local overrides. Docker Compose sets the service URLs itself.
OVAS_DATABASE_URL=postgresql+asyncpg://ovas:ovas@localhost:5432/ovas
OVAS_RUNTIME_URL=http://localhost:8100
OVAS_TTS_URL=http://localhost:8002
# Browser origins allowed to make state-changing requests (JSON list).
OVAS_ALLOWED_ORIGINS=["http://localhost:5173"]
